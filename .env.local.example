# Copy this file to .env.local and fill in values.
# Secrets required for each step are loaded lazily — running `pnpm dev` only
# needs these once you reach the step that uses them.

# Step 4: Claude
ANTHROPIC_API_KEY=

# Step 2: Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Step 9: Session cookie
# openssl rand -hex 32
SESSION_COOKIE_SECRET=
# openssl rand -hex 16
IP_HASH_SALT=

# Step 10: Toss Payments (test keys OK for MVP)
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# Watermark kill switch (true = watermark shown on free exports)
WATERMARK_ENABLED=true
